# Copy to .env and fill in. Never commit .env. See docs/DEPLOYMENT.md.
# The AI layer is optional: without the OCI values the agent uses rule-generated text and the
# assistant answers with engine data only.

# ---- Sign-in and sessions ----
# Signs the session cookies. Required on a server, or everyone is signed out at every restart.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
RECON_SECRET_KEY=
# Accounts file (default output/users.json). On first start, when it does not exist, the worklist
# creates the demo accounts planner1, planner2, supervisor1, supervisor2 and manager1 and prints
# their passwords to its log once. Manage accounts with: python -m recon_agent users --help
# RECON_USERS_FILE=output/users.json
# One password for every demo account instead of random ones (demos only; 10+ characters).
RECON_DEMO_PASSWORD=
# Hours a sign-in lasts.
RECON_SESSION_HOURS=12
# on = session cookies over HTTPS only (browsers also accept them on http://localhost).
# off only for a plain-HTTP test server reached by another name.
RECON_COOKIE_SECURE=on
# Public origin(s) allowed to POST, when the app sits behind a proxy that rewrites Host.
# RECON_ALLOWED_ORIGINS=https://recon.example.com
# Proxies trusted for X-Forwarded-For / -Proto (docker-compose.yml sets *).
# RECON_FORWARDED_ALLOW_IPS=127.0.0.1
# on = Swagger UI at /api/docs.
RECON_API_DOCS=off

# ---- TLS (docker compose --profile tls) ----
# RECON_DOMAIN=recon.example.com

# ---- Source data ----
# excel  = the five daily extracts in data/ (default)
# events = the simulated real-time event feed (python -m recon_agent events seed), see
#          docs/EVENT_CONTRACT.md. Event mode keeps its log, decisions and reports in output/sim/.
RECON_SOURCE=excel
# RECON_EVENT_DB=output/sim/events.db

# ---- Source simulator (python -m recon_agent simulate) ----
# Operators sign in with the worklist's accounts.
# Where the simulator's "Open worklist" button points.
RECON_WORKLIST_URL=http://localhost:8000/
# Write-back: where the worklist sends approved corrections (the simulator stands in for Oracle
# Integration), and a shared token both sides must use: set it whenever the simulator is
# reachable from another machine (any long random string).
RECON_CORRECTIONS_URL=http://127.0.0.1:8100/oic/corrections
RECON_CORRECTIONS_TOKEN=
# off = never call the model (offline demos), even with the OCI credentials below.
RECON_AI=on

# ---- OCI Generative AI (API-key auth) ----
OCI_REGION=us-chicago-1
OCI_COMPARTMENT_ID=
OCI_SERVICE_ENDPOINT=
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=
# The PEM on one line with a literal \n between its lines, or use OCI_PRIVATE_KEY_PATH instead.
OCI_PRIVATE_KEY=
OCI_PRIVATE_KEY_PATH=
OCI_PRIVATE_KEY_PASSPHRASE=
# Used only when the OCI_USER_OCID/TENANCY/FINGERPRINT values above are empty (~/.oci/config).
OCI_CONFIG_PROFILE=DEFAULT

# ---- Model (default: Gemini 2.5 Pro on OCI) ----
OCI_MODEL_ID=google.gemini-2.5-pro
