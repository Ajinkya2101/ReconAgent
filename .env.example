# Copy to .env and fill in. The AI layer is optional: without these values the
# agent uses rule-generated text and the assistant answers with engine data only.

# ---- Source data ----
# excel  = the five daily extracts in data/ (default)
# events = the simulated real-time event feed (python -m recon_agent events seed), see
#          docs/EVENT_CONTRACT.md. Event mode keeps its log, decisions and reports in output/sim/.
RECON_SOURCE=excel
# RECON_EVENT_DB=output/sim/events.db

# ---- Source simulator (python -m recon_agent simulate) ----
# Empty = operators sign in with a name only (local POC). Set a passcode before sharing the URL.
RECON_SIM_PASSCODE=
# Where the simulator's "Open worklist" button points.
RECON_WORKLIST_URL=http://localhost:8000/
# Write-back: where the worklist sends approved corrections (the simulator stands in for Oracle
# Integration), and an optional shared token both sides must use.
RECON_CORRECTIONS_URL=http://127.0.0.1:8100/oic/corrections
RECON_CORRECTIONS_TOKEN=
# off = never call the model (offline demos), even with the OCI credentials below.
RECON_AI=on

# ---- OCI Generative AI (API-key auth) ----
OCI_REGION=us-chicago-1
OCI_COMPARTMENT_ID=
OCI_SERVICE_ENDPOINT=
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=
# The PEM on one line with a literal \n between its lines, or use OCI_PRIVATE_KEY_PATH instead.
OCI_PRIVATE_KEY=
OCI_PRIVATE_KEY_PATH=
OCI_PRIVATE_KEY_PASSPHRASE=
# Used only when the OCI_USER_OCID/TENANCY/FINGERPRINT values above are empty (~/.oci/config).
OCI_CONFIG_PROFILE=DEFAULT

# ---- Model (default: Gemini 2.5 Pro on OCI) ----
OCI_MODEL_ID=google.gemini-2.5-pro
